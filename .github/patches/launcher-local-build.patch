+fn install_local_apk(worker_message_sender: &Sender<WorkerMessage>) -> Result<()> {
+    worker_message_sender.send(WorkerMessage::ProgressUpdate(Progress {
+        message: "Installing local Quest APK".into(),
+        progress: 0.0,
+    }))?;
+
+    let launcher_dir = env::current_exe()?
+        .parent()
+        .context("Unable to determine launcher directory")?
+        .to_path_buf();
+    let apk_path = launcher_dir.join("alvr_client_android.apk");
+    if !apk_path.is_file() {
+        bail!("Local APK not found at {}", apk_path.display())
+    }
+
+    // Local builds use system ADB and never download platform-tools.
+    let adb_path = "adb";
+    let device_serial = alvr_adb::commands::list_devices(adb_path)?
+        .into_iter()
+        .find_map(|device| device.serial)
+        .context("No connected ADB device found")?;
+    let application_id = alvr_system_info::PACKAGE_NAME_GITHUB_DEV;
+    if alvr_adb::commands::is_package_installed(adb_path, &device_serial, application_id)? {
+        worker_message_sender.send(WorkerMessage::ProgressUpdate(Progress {
+            message: "Removing installed development client".into(),
+            progress: 0.25,
+        }))?;
+        alvr_adb::commands::uninstall_package(adb_path, &device_serial, application_id)?;
+    }
+    alvr_adb::commands::install_package(adb_path, &device_serial, &apk_path.to_string_lossy())?;
+    alvr_adb::commands::start_application(adb_path, &device_serial, application_id)?;
+
+    Ok(())
+}
