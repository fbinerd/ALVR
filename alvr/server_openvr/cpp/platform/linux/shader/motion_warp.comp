#version 450
// Inverse warp with bidirectional consistency, derived from our CPU reference.
layout(local_size_x=8,local_size_y=8) in;
// The checker can specialize this off to retain the five-iteration control.
layout(constant_id=0) const bool exactFlowExit=true;
layout(binding=0) uniform sampler2D previousImage;
layout(binding=1) uniform sampler2D latestImage;
layout(binding=2) uniform isampler2D forwardLeft;
layout(binding=3) uniform isampler2D backwardLeft;
layout(binding=4) uniform isampler2D forwardRight;
layout(binding=5) uniform isampler2D backwardRight;
// Optional canonical depth (view distance in metres, +0 invalid/sky) of the
// two retained pictures, at any extent. Sampled only when flags bit 0.
layout(binding=6) uniform sampler2D previousDepth;
layout(binding=7) uniform sampler2D latestDepth;
layout(binding=8) uniform writeonly image2D outputImage;
layout(push_constant) uniform Params {
    uint eyeWidth,height,lumaWidth,lumaHeight;
    float time; uint rotationMode,eye,flags;
    vec4 previousQuaternion,targetQuaternion,leftTans,rightTans;
    vec4 targetTranslation; // xyz metres, source-from-destination
    vec4 previousTranslation; // history: older-from-newest, xyz metres
} p;
vec2 rotatePixel(vec2 at,bool right,vec4 quat) {
    if (all(equal(quat,vec4(0,0,0,1)))) return at;
    vec4 t=right?p.rightTans:p.leftTans;
    vec2 uv=(at+0.5)/vec2(p.eyeWidth,p.height);
    vec3 v=vec3(mix(t.x,t.y,uv.x),mix(t.z,t.w,uv.y),-1);
    v+=2.0*cross(quat.xyz,cross(quat.xyz,v)+quat.w*v);
    if(v.z>=-1e-5) return vec2(-10000);
    vec2 ray=v.xy/-v.z;
    return vec2((ray.x-t.x)/(t.y-t.x),(ray.y-t.z)/(t.w-t.z))
        *vec2(p.eyeWidth,p.height)-0.5;
}
vec2 olderPixel(vec2 at,bool right);
// The flow grid is coarser than output pixels. Solve four tile corners once
// rather than repeating the iterative inversion for every output pixel.
shared vec2 cornerDisplacement[4];
shared uint cornerValid[4];
// A coarse luma grid cannot reliably distinguish subpixel motion from noise.
// Fit a small local brightness-motion model using full-resolution RGB history.
// Each of 16 lanes contributes normal equations for a 2D translation; a tile
// may use temporal prediction only when that translation explains its change.
shared vec4 temporalNormal[16]; // xx, xy, yy, squared temporal change
shared vec2 temporalRhs[16];
shared vec3 temporalChange[16];
shared uint temporalTile;
shared uint colorOnlyTile;
vec3 historyAt(bool recent,bool right,ivec2 q) {
    if (!recent && p.rotationMode!=0) q=ivec2(round(olderPixel(vec2(q),right)));
    q=clamp(q,ivec2(0),ivec2(p.eyeWidth-1,p.height-1));
    q.x+=right?int(p.eyeWidth):0;
    return recent?texelFetch(latestImage,q,0).rgb:texelFetch(previousImage,q,0).rgb;
}
void fitTemporalTile(uvec2 base,bool right,bool fullTile) {
    uint i=gl_LocalInvocationIndex;
    if (i<16) {
        vec4 normal=vec4(0);
        vec2 rhs=vec2(0);
        vec3 dt=vec3(0);
        if (fullTile) {
            ivec2 q=ivec2(base.x%p.eyeWidth,base.y)+ivec2(1+2*(i%4),1+2*(i/4));
            dt=historyAt(true,right,q)-historyAt(false,right,q);
            // Averaging gradients from both histories is symmetric in time.
            vec3 dx=vec3(0),dy=vec3(0);
            for (int frame=0;frame<2;frame++) {
                dx+=historyAt(frame!=0,right,q+ivec2(1,0))
                    -historyAt(frame!=0,right,q-ivec2(1,0));
                dy+=historyAt(frame!=0,right,q+ivec2(0,1))
                    -historyAt(frame!=0,right,q-ivec2(0,1));
            }
            dx*=0.25;
            dy*=0.25;
            normal=vec4(dot(dx,dx),dot(dx,dy),dot(dy,dy),dot(dt,dt));
            rhs=vec2(dot(dx,dt),dot(dy,dt));
        }
        temporalNormal[i]=normal;
        temporalRhs[i]=rhs;
        temporalChange[i]=dt;
    }
    barrier();
    if (i==0) {
        vec4 a=vec4(0);
        vec2 b=vec2(0);
        for (int j=0;j<16;j++) {
            a+=temporalNormal[j];
            b+=temporalRhs[j];
        }
        float trace=a.x+a.z;
        // A small ridge bounds the aperture problem. The residual below is
        // evaluated against the original equations, without the ridge.
        float ridge=max(trace*0.01,1e-8);
        float det=(a.x+ridge)*(a.z+ridge)-a.y*a.y;
        vec2 velocity=vec2((a.z+ridge)*b.x-a.y*b.y,
                           (a.x+ridge)*b.y-a.y*b.x)/det;
        float residual=max(0.0,a.w-2.0*dot(b,velocity)
            +a.x*velocity.x*velocity.x+2.0*a.y*velocity.x*velocity.y
            +a.z*velocity.y*velocity.y);
        bool valid=fullTile && trace>1e-5 && a.w>1e-6
            && !any(isnan(velocity)) && !any(isinf(velocity))
            && dot(velocity,velocity)<=1.0 && residual<=0.25*a.w;
        temporalTile=valid?1:0;
        vec3 low=temporalChange[0],high=low;
        for (int j=1;j<16;j++) {
            low=min(low,temporalChange[j]);
            high=max(high,temporalChange[j]);
        }
        // A uniform chroma change is not geometric motion. Reject the noisy
        // coarse flow only where the output pixel shares that same change;
        // moving edges and mixed tiles still take the spatial warp path.
        float magnitude=max(max(abs(low.r),abs(low.g)),abs(low.b));
        bool uniformChange=all(lessThanEqual(high-low,vec3(1.25/255.0)));
        colorOnlyTile=fullTile && !valid && uniformChange && magnitude>=2.0/255.0?1:0;
    }
    barrier();
}
bool hasDepth() { return (p.flags&1u)!=0u; }
// Depth-based occlusion handling (flow affinity, edge candidates), flags bit
// 3. Off by default: it helped analytic scenes but not real Open Brush
// recordings, where only the positional correction improved the result.
bool depthOcclusion() { return hasDepth() && (p.flags&8u)!=0u; }
vec4 colorAt(bool recent,bool right,vec2 q);
// Content at q in the newest picture was at q+v in the older one (backward
// flow v), judged on a small cross of samples.
bool motionMatches(bool right,vec2 q,vec2 v) {
    const vec2 taps[5]=vec2[5](vec2(0),vec2(2,0),vec2(-2,0),vec2(0,2),vec2(0,-2));
    float error=0.0;
    for (int i=0;i<5;i++) {
        vec3 d=colorAt(true,right,q+taps[i]).rgb-colorAt(false,right,q+v+taps[i]).rgb;
        error+=abs(d.r)+abs(d.g)+abs(d.b);
    }
    return error/15.0<=12.0/255.0;
}
// Depth of a picture position, in that picture's own geometry (the older
// picture is sampled through the history rotation, like colorAt). Invalid
// or sky depth counts as very far.
float depthAt(bool recent,bool right,vec2 q) {
    if (!recent && p.rotationMode!=0) q=olderPixel(q,right);
    // Depth may have its own extent; both eyes side by side like the colour.
    q=clamp(q,vec2(0),vec2(p.eyeWidth-1,p.height-1));
    q.x+=right?float(p.eyeWidth):0.0;
    vec2 size=vec2(textureSize(latestDepth,0));
    ivec2 i=clamp(ivec2((q+0.5)*size/vec2(2*p.eyeWidth,p.height)),ivec2(0),ivec2(size)-1);
    float d=recent?texelFetch(latestDepth,i,0).r:texelFetch(previousDepth,i,0).r;
    return d>0.0 && !isinf(d) && !isnan(d)?d:1e4;
}
// Depth edges are judged in inverse depth (1/m): on any plane, slanted
// floors included, inverse depth is affine in the picture, and the parallax
// a head or object motion causes scales with inverse-depth differences.
// Far/far boundaries (5 m against 10 m, ground against sky) barely move
// apart and do not count.
const float InverseDepthEdge=0.15;
// 1 on the same surface, falling off with inverse-depth difference.
float depthAffinity(float a,float b) {
    float r=abs(1.0/a-1.0/b)/InverseDepthEdge;
    return 1.0/(1.0+r*r);
}
bool positionalHistory() {
    return hasDepth() && dot(p.previousTranslation.xyz,p.previousTranslation.xyz)>0.0;
}
// Direct fetch (GLSL forbids the static recursion through depthAt).
float newestDepth(vec2 q,bool right) {
    q=clamp(q,vec2(0),vec2(p.eyeWidth-1,p.height-1));
    q.x+=right?float(p.eyeWidth):0.0;
    vec2 size=vec2(textureSize(latestDepth,0));
    float d=texelFetch(latestDepth,clamp(ivec2((q+0.5)*size/vec2(2*p.eyeWidth,p.height)),ivec2(0),ivec2(size)-1),0).r;
    return d>0.0 && !isinf(d) && !isnan(d)?d:1e4;
}
// Positional-correction weight by content distance: stereo (and near
// game) depth is unreliable on very near content, and its parallax is large,
// so a depth error there became a visible deformation of a hand held still
// (Quest, 2026-10-23). Below 0.4 m the content keeps rotation-only behaviour;
// the correction fades in up to 0.8 m.
float positionalWeight(float metres) { return smoothstep(0.4,0.8,metres); }
vec3 rotateVector(vec4 quat,vec3 v) {
    return v+2.0*cross(quat.xyz,cross(quat.xyz,v)+quat.w*v);
}
// Older-picture position of a newest-picture position. With depth and a
// head translation the newest depth places the content in 3D, so parallax
// is aligned too; otherwise rotation only.
vec2 olderPixel(vec2 at,bool right) {
    if (!positionalHistory()) return rotatePixel(at,right,p.previousQuaternion);
    vec4 t=right?p.rightTans:p.leftTans;
    vec2 size=vec2(p.eyeWidth,p.height);
    vec2 uv=(at+0.5)/size;
    float z=newestDepth(at,right);
    vec3 point=vec3(mix(t.x,t.y,uv.x),mix(t.z,t.w,uv.y),-1)*z;
    vec3 v=rotateVector(p.previousQuaternion,point)+p.previousTranslation.xyz*positionalWeight(z);
    if(v.z>=-1e-5) return vec2(-10000);
    vec2 ray=v.xy/-v.z;
    return vec2((ray.x-t.x)/(t.y-t.x),(ray.y-t.z)/(t.w-t.z))*size-0.5;
}
// Positional correction (needs depth): the newest-picture position whose
// content the destination eye, rotated and moved by the target transform,
// sees at this pixel. Fixed point on the newest picture's depth: a source
// position gives a 3D point, the point's destination depth gives a point on
// the destination ray, and that point projects to the next source position.
vec2 positionalPixel(vec2 at,bool right) {
    vec4 t=right?p.rightTans:p.leftTans;
    vec2 size=vec2(p.eyeWidth,p.height);
    vec2 uv=(at+0.5)/size;
    vec3 ray=vec3(mix(t.x,t.y,uv.x),mix(t.z,t.w,uv.y),-1);
    vec4 inverse=vec4(-p.targetQuaternion.xyz,p.targetQuaternion.w);
    vec2 q=rotatePixel(at,right,p.targetQuaternion);
    for (int i=0;i<4;i++) {
        vec2 sq=clamp(q,vec2(0),size-1.0);
        vec2 suv=(sq+0.5)/size;
        float z=depthAt(true,right,sq);
        vec3 source=vec3(mix(t.x,t.y,suv.x),mix(t.z,t.w,suv.y),-1)*z;
        vec3 moved=p.targetTranslation.xyz*positionalWeight(z);
        vec3 destination=rotateVector(inverse,source-moved);
        float zd=max(-destination.z,1e-3);
        vec3 back=rotateVector(p.targetQuaternion,ray*zd)+moved;
        if (back.z>=-1e-5) return vec2(-10000);
        vec2 r=back.xy/-back.z;
        q=vec2((r.x-t.x)/(t.y-t.x),(r.y-t.z)/(t.w-t.z))*size-0.5;
    }
    return q;
}
ivec2 vectorAt(bool reverse,bool right,ivec2 q) {
    if (right) return reverse?texelFetch(backwardRight,q,0).xy:texelFetch(forwardRight,q,0).xy;
    return reverse?texelFetch(backwardLeft,q,0).xy:texelFetch(forwardLeft,q,0).xy;
}
vec3 guideAt(bool right,vec2 q) {
    q=clamp(q,vec2(0),vec2(p.eyeWidth-1,p.height-1));
    q.x+=right?float(p.eyeWidth):0.0;
    return texture(latestImage,(q+0.5)/vec2(2*p.eyeWidth,p.height)).rgb;
}
vec2 flowAt(bool reverse,bool right,vec2 q) {
    vec2 scale=vec2(p.lumaWidth,p.lumaHeight)/vec2(p.eyeWidth,p.height);
    vec2 grid=vec2(p.lumaWidth/4,p.lumaHeight/4);
    vec2 v=clamp((q+0.5)*scale/4.0-0.5,vec2(0),grid-1);
    ivec2 a=ivec2(v), b=min(a+1,ivec2(grid)-1);
    vec2 f=fract(v);
    vec2 f00=vec2(vectorAt(reverse,right,a));
    vec2 f10=vec2(vectorAt(reverse,right,ivec2(b.x,a.y)));
    vec2 f01=vec2(vectorAt(reverse,right,ivec2(a.x,b.y)));
    vec2 f11=vec2(vectorAt(reverse,right,b));
    vec2 t=mix(mix(f00,f10,f.x),mix(f01,f11,f.x),f.y);
    if (depthOcclusion()) {
        // The flow grid is coarse: a near object's motion would otherwise
        // bleed into the background around it (drag) and vice versa. Weigh
        // each grid vector by how close its depth is to this pixel's depth.
        // The backward field lives on the newest picture, the forward one
        // on the older picture.
        vec2 c0=(vec2(a)+0.5)*4.0/scale-0.5;
        vec2 c1=(vec2(b)+0.5)*4.0/scale-0.5;
        float dq=depthAt(reverse,right,q);
        vec4 w=vec4((1-f.x)*(1-f.y),f.x*(1-f.y),(1-f.x)*f.y,f.x*f.y)*vec4(
            depthAffinity(depthAt(reverse,right,c0),dq),
            depthAffinity(depthAt(reverse,right,vec2(c1.x,c0.y)),dq),
            depthAffinity(depthAt(reverse,right,vec2(c0.x,c1.y)),dq),
            depthAffinity(depthAt(reverse,right,c1),dq))+1e-6;
        t=(w.x*f00+w.y*f10+w.z*f01+w.w*f11)/dot(w,vec4(1));
        if ((p.rotationMode&4u)!=0u) {
            vec2 pixels=t/32.0/scale;
            return pixels*smoothstep(0.5,1.5,length(pixels));
        }
        return t/32.0/scale;
    }
    if ((p.rotationMode&4u)!=0u) {
        // Continuous rational colour weights avoid an exponential/loop inside
        // every inverse-flow iteration and reuse the four vector samples.
        vec3 guide=guideAt(right,q);
        vec2 c0=(vec2(a)+0.5)*4.0/scale-0.5;
        vec2 c1=(vec2(b)+0.5)*4.0/scale-0.5;
        vec3 d00=guideAt(right,c0)-guide;
        vec3 d10=guideAt(right,vec2(c1.x,c0.y))-guide;
        vec3 d01=guideAt(right,vec2(c0.x,c1.y))-guide;
        vec3 d11=guideAt(right,c1)-guide;
        vec4 w=vec4((1-f.x)*(1-f.y),f.x*(1-f.y),(1-f.x)*f.y,f.x*f.y)
            /(1.0+50.0*vec4(dot(d00,d00),dot(d10,d10),dot(d01,d01),dot(d11,d11)));
        t=(w.x*f00+w.y*f10+w.z*f01+w.w*f11)/dot(w,vec4(1));
        vec2 pixels=t/32.0/scale;
        // Thresholds are in full output pixels, independent of luma scale.
        return pixels*smoothstep(0.5,1.5,length(pixels));
    }
    return t/32.0/scale;
}
bool inside(vec2 q) {
    return !any(isnan(q)) && !any(isinf(q)) && all(greaterThanEqual(q,vec2(0)))
        && all(lessThanEqual(q,vec2(p.eyeWidth-1,p.height-1)));
}
float residualConfidence=1.0;
bool sourceAt(vec2 target,float distance,bool reverse,bool right,out vec2 q) {
    q=target;
    vec2 v=vec2(0);
    bool settled=false;
    for (int i=0;i<5;i++) {
        if (!inside(q)) return false;
        v=flowAt(reverse,right,q);
        vec2 next=target-distance*v;
        // Exact equality is a fixed point: repeating the same texture samples
        // and arithmetic cannot move q again. No tolerance changes the solve.
        if (exactFlowExit && all(equal(next,q))) {
            settled=true;
            break;
        }
        q=next;
    }
    if (!inside(q)) return false;
    if (!settled) v=flowAt(reverse,right,q);
    vec2 other=q+v;
    // Mode 7 blends reciprocal/inversion disagreement continuously instead
    // of introducing a hard valid/invalid edge at a flow-cell boundary.
    if ((p.rotationMode&4u)!=0u) {
        residualConfidence=(1.0-smoothstep(0.25,1.5,length(q+distance*v-target)))
            *(1.0-smoothstep(0.75,3.0,length(v+flowAt(!reverse,right,other))));
        return inside(other);
    }
    // Thresholds are in full-resolution pixels at either estimator resolution.
    return inside(other) && length(q+distance*v-target)<=1.0
        && length(v+flowAt(!reverse,right,other))<=2.0;
}
vec4 colorAt(bool recent,bool right,vec2 q) {
    if (!recent && p.rotationMode!=0) q=olderPixel(q,right);
    q=clamp(q,vec2(0),vec2(p.eyeWidth-1,p.height-1));
    q.x+=right?float(p.eyeWidth):0.0;
    vec2 uv=(q+0.5)/vec2(2*p.eyeWidth,p.height);
    return recent?texture(latestImage,uv):texture(previousImage,uv);
}
// Catmull-Rom (4x4 texels, clamped to the eye) for final output samples of
// interpolated pictures: half-motion positions fall between texels, and a
// bilinear read there softened every moving edge (~8% less edge energy than
// the real pictures around it, read as flicker when alternating).
vec4 sharpColorAt(bool recent,bool right,vec2 q) {
    if (!recent && p.rotationMode!=0) q=olderPixel(q,right);
    q=clamp(q,vec2(0),vec2(p.eyeWidth-1,p.height-1));
    vec2 base=floor(q), t=q-base;
    vec4 wx=vec4(((-0.5*t.x+1.0)*t.x-0.5)*t.x, (1.5*t.x-2.5)*t.x*t.x+1.0,
                 ((-1.5*t.x+2.0)*t.x+0.5)*t.x, (0.5*t.x-0.5)*t.x*t.x);
    vec4 wy=vec4(((-0.5*t.y+1.0)*t.y-0.5)*t.y, (1.5*t.y-2.5)*t.y*t.y+1.0,
                 ((-1.5*t.y+2.0)*t.y+0.5)*t.y, (0.5*t.y-0.5)*t.y*t.y);
    vec4 sum=vec4(0);
    int offset=right?int(p.eyeWidth):0;
    for (int j=0;j<4;j++) for (int i=0;i<4;i++) {
        ivec2 c=ivec2(clamp(base+vec2(i-1,j-1),vec2(0),vec2(p.eyeWidth-1,p.height-1)));
        c.x+=offset;
        vec4 v=recent?texelFetch(latestImage,c,0):texelFetch(previousImage,c,0);
        sum+=wx[i]*wy[j]*v;
    }
    return clamp(sum,vec4(0),vec4(1));
}
void main() {
    uvec2 xy=gl_GlobalInvocationID.xy;
    uvec2 base=gl_WorkGroupID.xy*8;
    bool tileRight=base.x>=p.eyeWidth;
    // A partial tile or a tile crossing the eye seam takes the exact path.
    bool fullTile=base.y+7<p.height
        && base.x+7<(tileRight?2*p.eyeWidth:p.eyeWidth);
    bool rotated=p.rotationMode!=0 &&
        (!all(equal(p.previousQuaternion,vec4(0,0,0,1))) ||
         !all(equal(p.targetQuaternion,vec4(0,0,0,1))));
    bool stable=(p.rotationMode&4u)!=0u;
    if(!rotated && !stable) fitTemporalTile(base,tileRight,fullTile);
    else { if(gl_LocalInvocationIndex==0) {temporalTile=0; colorOnlyTile=0;} barrier(); }
    if(rotated || stable) fullTile=false;
    if (gl_LocalInvocationIndex<4) {
        uint i=gl_LocalInvocationIndex;
        vec2 at=vec2(base.x%p.eyeWidth+(i%2)*7,base.y+(i/2)*7), source;
        bool valid=false;
        if (fullTile && temporalTile==0 && colorOnlyTile==0)
            valid=sourceAt(at,1.0-p.time,true,tileRight,source);
        cornerValid[i]=valid?1:0;
        cornerDisplacement[i]=valid?source-at:vec2(0);
    }
    // Inactive edge invocations must participate before returning.
    barrier();
    if (xy.x>=2*p.eyeWidth || xy.y>=p.height) return;
    bool right=xy.x>=p.eyeWidth;
    vec2 target=vec2(xy.x%p.eyeWidth,xy.y), q;
    if(p.rotationMode!=0) target=hasDepth() && dot(p.targetTranslation.xyz,p.targetTranslation.xyz)>0.0
        ? positionalPixel(target,right) : rotatePixel(target,right,p.targetQuaternion);
    vec4 color=p.rotationMode!=0?colorAt(true,right,target):texelFetch(latestImage,ivec2(xy),0);
    vec4 rotationOnly=color;
    // Depth edge near this pixel: the occlusion resolution below handles it,
    // so the static shortcuts (which would leave an arriving object behind)
    // do not apply.
    // Opposite directions in consecutive pairs (second differences).
    const vec2 directions[8]=vec2[8](vec2(1,0),vec2(-1,0),vec2(0,1),vec2(0,-1),
        vec2(.7071,.7071),vec2(-.7071,-.7071),vec2(.7071,-.7071),vec2(-.7071,.7071));
    const float radii[3]=float[3](3.0,8.0,20.0);
    bool depthEdge=false;
    float farthestInverse=0.0;
    if (depthOcclusion() && (p.rotationMode&8u)==0u) {
        // A discontinuity breaks the affine inverse depth: test the second
        // difference across the pixel on four axes at three radii. A plane
        // gives zero whatever its slant.
        float w0=1.0/depthAt(true,right,target);
        farthestInverse=w0;
        float nearestInverse=w0;
        for (int r=0;r<3;r++) for (int d=0;d<8;d+=2) {
            float wp=1.0/depthAt(true,right,target+radii[r]*directions[d]);
            float wm=1.0/depthAt(true,right,target+radii[r]*directions[d+1]);
            farthestInverse=min(farthestInverse,min(wp,wm));
            nearestInverse=max(nearestInverse,max(wp,wm));
            depthEdge=depthEdge || abs(wp+wm-2.0*w0)>InverseDepthEdge;
        }
        // An edge that nothing moves across needs no occlusion handling, and
        // the exact static path (mode 7 keeps unchanged pixels) is better
        // there than resampling. Require visible motion nearby: flow, or the
        // parallax the head translation opens across this edge.
        if (depthEdge) {
            vec4 t=right?p.rightTans:p.leftTans;
            float pixelsPerTangent=float(p.eyeWidth)/abs(t.y-t.x);
            float parallax=pixelsPerTangent*length(p.targetTranslation.xy)*(nearestInverse-farthestInverse);
            bool moving=parallax>0.75 || length(flowAt(true,right,target))>0.75;
            for (int d=0;d<8 && !moving;d++)
                moving=length(flowAt(true,right,target+radii[2]*directions[d]))>0.75;
            depthEdge=moving;
        }
    }
    if(stable && !depthEdge) {
        // Newly exposed pixels have no history. Retain the rotation-only
        // newest picture, rather than extending a residual edge vector.
        vec2 older=olderPixel(target,right);
        if(!inside(target) || !inside(older)) {
            imageStore(outputImage,ivec2(xy),rotationOnly); return;
        }
        vec3 change=abs(rotationOnly.rgb-colorAt(false,right,target).rgb);
        if(max(max(change.r,change.g),change.b)<=1.0/255.0) {
            imageStore(outputImage,ivec2(xy),rotationOnly); return;
        }
    }
    vec4 previous=texelFetch(previousImage,ivec2(xy),0);
    vec3 delta=color.rgb-previous.rgb;
    float horizon=p.time-1.0;
    if (!depthEdge && colorOnlyTile!=0 && all(lessThanEqual(abs(delta-temporalChange[0]),
                                            vec3(1.25/255.0)))) {
        imageStore(outputImage,ivec2(xy),color);
        return;
    }
    if (!depthEdge && temporalTile!=0 && horizon>0
        && max(max(abs(delta.r),abs(delta.g)),abs(delta.b))<=16.0/255.0) {
        color.rgb=clamp(color.rgb+horizon*delta,vec3(0),vec3(1));
        imageStore(outputImage,ivec2(xy),color);
        return;
    }
    bool smoothTile=fullTile;
    for (int i=0;i<4;i++)
        smoothTile=smoothTile && cornerValid[i]!=0
            && length(cornerDisplacement[i]-cornerDisplacement[0])<=0.5;
    bool valid;
    if (smoothTile) {
        vec2 f=vec2(gl_LocalInvocationID.xy)/7.0;
        q=target+mix(mix(cornerDisplacement[0],cornerDisplacement[1],f.x),
                     mix(cornerDisplacement[2],cornerDisplacement[3],f.x),f.y);
        valid=inside(q);
    } else {
        // Motion boundaries and failed corner checks retain per-pixel inversion.
        valid=sourceAt(target,1.0-p.time,true,right,q);
        if (!valid && !stable) {
            // Occlusion edges fail the consistency check. Leaving the pixel
            // unmoved while its neighbours move tears edges into blocks, so
            // take the smallest candidate motion instead: near an occlusion
            // that is usually the background, which a disocclusion reveals.
            vec2 best=(p.time-1.0)*flowAt(true,right,target);
            for (int i=0;i<4;i++)
                if (cornerValid[i]!=0
                    && dot(cornerDisplacement[i],cornerDisplacement[i])<dot(best,best))
                    best=cornerDisplacement[i];
            q=target+best;
            valid=inside(q);
        }
    }
    if (valid) {
        vec4 source=colorAt(true,right,q);
        // Comparing the actual sampled source detects an entering moving edge;
        // identity at both sites preserves the exact current texel. This replaces
        // two 3x3 patch scans per output pixel.
        bool unchanged=all(equal(previous,color))
            && all(equal(colorAt(false,right,q),source));
        if (!unchanged) color=source;
    }
    bool depthResolved=false;
    if (depthEdge) {
        // Near a depth edge the single inverse solution above can land on
        // the wrong surface: the background dragged with a near hand, or
        // the hand left behind where it uncovered the background (a shadow).
        // Gather motion candidates around the pixel; each one says where its
        // content would come from. A candidate counts when the content found
        // there really moves that way and is on the candidate's surface.
        // The nearest such content covers the pixel. When none does, the
        // pixel was just uncovered: take the nearest visible background.
        float distance=1.0-p.time;
        // The ordinary inverse solution stays unless depth shows it wrong:
        // on real pictures replacing a sound solution only adds resampling
        // error, and a background fill where nothing was uncovered smears.
        bool baseline=valid && motionMatches(right,q,flowAt(true,right,q));
        // Without a solution the pixel shows its rotation-only content.
        vec2 baselineAt=valid?q:target;
        float baselineInverse=1.0/depthAt(true,right,baselineAt);
        {
            float coverDepth=1e9; vec2 cover=vec2(0), coverMotion=vec2(0); bool covered=false;
            float fillScore=1e9; vec2 fill=target; vec2 fillMotion=vec2(0);
            for (int k=0;k<25;k++) {
                vec2 c=k==0?target:target+radii[(k-1)/8]*directions[(k-1)%8];
                if (!inside(c)) continue;
                vec2 v=flowAt(true,right,c);
                float zc=depthAt(true,right,c);
                vec2 qc=target-distance*v;
                if (inside(qc)) {
                    float zq=depthAt(true,right,qc);
                    // Photometric check: the coarse flow itself can be wrong
                    // next to an edge (background motion leaking into the
                    // object), so test whether the content at qc really was
                    // at qc+v in the older picture.
                    bool moves=motionMatches(right,qc,v);
                    if (moves && depthAffinity(zq,zc)>0.5 && zq<coverDepth) {
                        coverDepth=zq; cover=qc; coverMotion=v; covered=true;
                    }
                }
                // Background candidates near the pixel fill an uncovered area.
                float score=length(c-target)+(1.0/zc-farthestInverse<=0.5*InverseDepthEdge?0.0:1e5);
                if (score<fillScore) { fillScore=score; fill=c; fillMotion=v; }
            }
            // A cover replaces a sound baseline only when clearly nearer
            // (a near object arriving over the background).
            // ...and only an object with its own motion arrives: under a head
            // rotation everything moves together and the baseline is right.
            bool nearer=covered && 1.0/coverDepth>baselineInverse+0.5*InverseDepthEdge
                && length(coverMotion-flowAt(true,right,baselineAt))>1.0;
            // Uncovered: nothing consistent lands here and the newest picture
            // shows the near side of the edge here (the object that left).
            // The background now revealed is hidden in the newest picture but
            // may be visible in the older one: follow the background motion
            // there and use it when the older depth confirms background.
            // Otherwise keep the ordinary result: stretching the nearby
            // background measured worse than it on real pictures.
            // Measured on real recordings, both fills (stretching the nearby
            // background, and the older picture along background motion)
            // were worse than the ordinary result; kept off (flags bit 2
            // re-enables the older-picture fill for experiments).
            bool uncovered=false;
            if ((p.flags&4u)!=0u && !baseline && !covered
                && 1.0/depthAt(true,right,target)-farthestInverse>InverseDepthEdge) {
                vec2 older=target-distance*fillMotion+fillMotion;
                uncovered=inside(older)
                    && 1.0/depthAt(false,right,older)-farthestInverse<=0.5*InverseDepthEdge;
                if (uncovered) {
                    color=colorAt(false,right,older);
                    depthResolved=true;
                }
            }
            if (nearer) {
                q=cover;
                valid=inside(q);
                depthResolved=valid;
                if (depthResolved) color=colorAt(true,right,q);
            }
            // Diagnostic: red covered, green filled, blue baseline kept.
            if ((p.flags&2u)!=0u) {
                color=nearer?vec4(1,0,0,1):uncovered?vec4(0,1,0,1):vec4(0,0,1,1);
                depthResolved=true;
            }
        }
    }
    if ((p.rotationMode&8u)!=0u) {
        // Interpolation (time in (0, 1)): also follow the forward flow back
        // into the older picture. Each side keeps its own consistency and
        // the side closer in time weighs more, so content hidden in one
        // picture (behind a moving hand) is taken from the other.
        float confLatest=valid?residualConfidence:0.0;
        // Sharper final samples for the interpolated picture.
        if (valid) color=sharpColorAt(true,right,q);
        vec4 fromLatest=color;
        vec2 qOld;
        bool validOld=sourceAt(target,p.time,false,right,qOld);
        float confOld=validOld?residualConfidence:0.0;
        vec4 fromOld=validOld?sharpColorAt(false,right,qOld):fromLatest;
        float wLatest=p.time*confLatest+1e-4, wOld=(1.0-p.time)*confOld;
        color=(wLatest*fromLatest+wOld*fromOld)/(wLatest+wOld);
        residualConfidence=max(confLatest,confOld);
    }
    if ((p.rotationMode&2u)!=0u) {
        // Continuous per-pixel confidence; no workgroup or tile thresholds.
        // Reciprocal flow rejects occlusion; brightness disagreement provides
        // a cost proxy without treating head rotation as object motion.
        vec2 back=flowAt(true,right,target);
        vec2 other=target+back;
        float disagreement=length(back+flowAt(false,right,other));
        vec3 newest=colorAt(true,right,target).rgb;
        vec3 alignedPrevious=colorAt(false,right,other).rgb;
        float cost=length(newest-alignedPrevious);
        float confidence=(1.0-smoothstep(0.5,3.0,disagreement))
            *(1.0-smoothstep(0.04,0.25,cost));
        if (!inside(target) || !inside(other)) confidence=0;
        color=mix(colorAt(true,right,target),color,confidence);
    }
    if(stable && !depthResolved) {
        vec3 change=abs(rotationOnly.rgb-colorAt(false,right,target).rgb);
        float activity=smoothstep(1.0/255.0,4.0/255.0,max(max(change.r,change.g),change.b));
        vec2 older=olderPixel(target,right);
        vec2 margin=min(older,vec2(p.eyeWidth-1,p.height-1)-older);
        float visible=smoothstep(0.0,8.0,min(margin.x,margin.y));
        color=mix(rotationOnly,color,activity*visible*residualConfidence);
    }
    imageStore(outputImage,ivec2(xy),color);
}
