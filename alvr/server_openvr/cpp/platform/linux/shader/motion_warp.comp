#version 450
// Inverse warp with bidirectional consistency, derived from our CPU reference.
layout(local_size_x=8,local_size_y=8) in;
layout(binding=0) uniform sampler2D previousImage;
layout(binding=1) uniform sampler2D latestImage;
layout(binding=2) uniform isampler2D forwardLeft;
layout(binding=3) uniform isampler2D backwardLeft;
layout(binding=4) uniform isampler2D forwardRight;
layout(binding=5) uniform isampler2D backwardRight;
layout(binding=6) uniform writeonly image2D outputImage;
layout(push_constant) uniform Params {
    uint eyeWidth,height,lumaWidth,lumaHeight;
    float time;
} p;
// The flow grid is coarser than output pixels. Solve four tile corners once
// rather than repeating the iterative inversion for every output pixel.
shared vec2 cornerDisplacement[4];
shared uint cornerValid[4];
// A coarse luma grid cannot reliably distinguish subpixel motion from noise.
// Fit a small local brightness-motion model using full-resolution RGB history.
// Each of 16 lanes contributes normal equations for a 2D translation; a tile
// may use temporal prediction only when that translation explains its change.
shared vec4 temporalNormal[16]; // xx, xy, yy, squared temporal change
shared vec2 temporalRhs[16];
shared uint temporalTile;
vec3 historyAt(bool recent,bool right,ivec2 q) {
    q=clamp(q,ivec2(0),ivec2(p.eyeWidth-1,p.height-1));
    q.x+=right?int(p.eyeWidth):0;
    return recent?texelFetch(latestImage,q,0).rgb:texelFetch(previousImage,q,0).rgb;
}
void fitTemporalTile(uvec2 base,bool right,bool fullTile) {
    uint i=gl_LocalInvocationIndex;
    if (i<16) {
        vec4 normal=vec4(0);
        vec2 rhs=vec2(0);
        if (fullTile) {
            ivec2 q=ivec2(base.x%p.eyeWidth,base.y)+ivec2(1+2*(i%4),1+2*(i/4));
            vec3 dt=historyAt(true,right,q)-historyAt(false,right,q);
            // Averaging gradients from both histories is symmetric in time.
            vec3 dx=vec3(0),dy=vec3(0);
            for (int frame=0;frame<2;frame++) {
                dx+=historyAt(frame!=0,right,q+ivec2(1,0))
                    -historyAt(frame!=0,right,q-ivec2(1,0));
                dy+=historyAt(frame!=0,right,q+ivec2(0,1))
                    -historyAt(frame!=0,right,q-ivec2(0,1));
            }
            dx*=0.25;
            dy*=0.25;
            normal=vec4(dot(dx,dx),dot(dx,dy),dot(dy,dy),dot(dt,dt));
            rhs=vec2(dot(dx,dt),dot(dy,dt));
        }
        temporalNormal[i]=normal;
        temporalRhs[i]=rhs;
    }
    barrier();
    if (i==0) {
        vec4 a=vec4(0);
        vec2 b=vec2(0);
        for (int j=0;j<16;j++) {
            a+=temporalNormal[j];
            b+=temporalRhs[j];
        }
        float trace=a.x+a.z;
        // A small ridge bounds the aperture problem. The residual below is
        // evaluated against the original equations, without the ridge.
        float ridge=max(trace*0.01,1e-8);
        float det=(a.x+ridge)*(a.z+ridge)-a.y*a.y;
        vec2 velocity=vec2((a.z+ridge)*b.x-a.y*b.y,
                           (a.x+ridge)*b.y-a.y*b.x)/det;
        float residual=max(0.0,a.w-2.0*dot(b,velocity)
            +a.x*velocity.x*velocity.x+2.0*a.y*velocity.x*velocity.y
            +a.z*velocity.y*velocity.y);
        bool valid=fullTile && trace>1e-5 && a.w>1e-6
            && !any(isnan(velocity)) && !any(isinf(velocity))
            && dot(velocity,velocity)<=1.0 && residual<=0.25*a.w;
        temporalTile=valid?1:0;
    }
    barrier();
}
ivec2 vectorAt(bool reverse,bool right,ivec2 q) {
    if (right) return reverse?texelFetch(backwardRight,q,0).xy:texelFetch(forwardRight,q,0).xy;
    return reverse?texelFetch(backwardLeft,q,0).xy:texelFetch(forwardLeft,q,0).xy;
}
vec2 flowAt(bool reverse,bool right,vec2 q) {
    vec2 scale=vec2(p.lumaWidth,p.lumaHeight)/vec2(p.eyeWidth,p.height);
    vec2 grid=vec2(p.lumaWidth/4,p.lumaHeight/4);
    vec2 v=clamp((q+0.5)*scale/4.0-0.5,vec2(0),grid-1);
    ivec2 a=ivec2(v), b=min(a+1,ivec2(grid)-1);
    vec2 f=fract(v);
    vec2 t=mix(mix(vec2(vectorAt(reverse,right,a)),vec2(vectorAt(reverse,right,ivec2(b.x,a.y))),f.x),
               mix(vec2(vectorAt(reverse,right,ivec2(a.x,b.y))),vec2(vectorAt(reverse,right,b)),f.x),f.y);
    return t/32.0/scale;
}
bool inside(vec2 q) {
    return !any(isnan(q)) && !any(isinf(q)) && all(greaterThanEqual(q,vec2(0)))
        && all(lessThanEqual(q,vec2(p.eyeWidth-1,p.height-1)));
}
bool sourceAt(vec2 target,float distance,bool reverse,bool right,out vec2 q) {
    q=target;
    for (int i=0;i<5;i++) {
        if (!inside(q)) return false;
        q=target-distance*flowAt(reverse,right,q);
    }
    if (!inside(q)) return false;
    vec2 v=flowAt(reverse,right,q), other=q+v;
    // Thresholds are in full-resolution pixels at either estimator resolution.
    return inside(other) && length(q+distance*v-target)<=1.0
        && length(v+flowAt(!reverse,right,other))<=2.0;
}
vec4 colorAt(bool recent,bool right,vec2 q) {
    q=clamp(q,vec2(0),vec2(p.eyeWidth-1,p.height-1));
    q.x+=right?float(p.eyeWidth):0.0;
    vec2 uv=(q+0.5)/vec2(2*p.eyeWidth,p.height);
    return recent?texture(latestImage,uv):texture(previousImage,uv);
}
void main() {
    uvec2 xy=gl_GlobalInvocationID.xy;
    uvec2 base=gl_WorkGroupID.xy*8;
    bool tileRight=base.x>=p.eyeWidth;
    // A partial tile or a tile crossing the eye seam takes the exact path.
    bool fullTile=base.y+7<p.height
        && base.x+7<(tileRight?2*p.eyeWidth:p.eyeWidth);
    fitTemporalTile(base,tileRight,fullTile);
    if (gl_LocalInvocationIndex<4) {
        uint i=gl_LocalInvocationIndex;
        vec2 at=vec2(base.x%p.eyeWidth+(i%2)*7,base.y+(i/2)*7), source;
        bool valid=false;
        if (fullTile && temporalTile==0)
            valid=sourceAt(at,1.0-p.time,true,tileRight,source);
        cornerValid[i]=valid?1:0;
        cornerDisplacement[i]=valid?source-at:vec2(0);
    }
    // Inactive edge invocations must participate before returning.
    barrier();
    if (xy.x>=2*p.eyeWidth || xy.y>=p.height) return;
    bool right=xy.x>=p.eyeWidth;
    vec2 target=vec2(xy.x%p.eyeWidth,xy.y), q;
    vec4 color=texelFetch(latestImage,ivec2(xy),0);
    vec4 previous=texelFetch(previousImage,ivec2(xy),0);
    vec3 delta=color.rgb-previous.rgb;
    float horizon=p.time-1.0;
    if (temporalTile!=0 && horizon>0
        && max(max(abs(delta.r),abs(delta.g)),abs(delta.b))<=16.0/255.0) {
        color.rgb=clamp(color.rgb+horizon*delta,vec3(0),vec3(1));
        imageStore(outputImage,ivec2(xy),color);
        return;
    }
    bool smoothTile=fullTile;
    for (int i=0;i<4;i++)
        smoothTile=smoothTile && cornerValid[i]!=0
            && length(cornerDisplacement[i]-cornerDisplacement[0])<=0.5;
    bool valid;
    if (smoothTile) {
        vec2 f=vec2(gl_LocalInvocationID.xy)/7.0;
        q=target+mix(mix(cornerDisplacement[0],cornerDisplacement[1],f.x),
                     mix(cornerDisplacement[2],cornerDisplacement[3],f.x),f.y);
        valid=inside(q);
    } else {
        // Motion boundaries and failed corner checks retain per-pixel inversion.
        valid=sourceAt(target,1.0-p.time,true,right,q);
    }
    if (valid) {
        vec4 source=colorAt(true,right,q);
        // Comparing the actual sampled source detects an entering moving edge;
        // identity at both sites preserves the exact current texel. This replaces
        // two 3x3 patch scans per output pixel.
        bool unchanged=all(equal(previous,color))
            && all(equal(colorAt(false,right,q),source));
        if (!unchanged) color=source;
    }
    imageStore(outputImage,ivec2(xy),color);
}
